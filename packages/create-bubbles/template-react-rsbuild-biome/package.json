{
  "name": "react-rsbuild-biomejs",
  "private": true,
  "version": "0.0.2",
  "scripts": {
    "dev": "rsbuild dev --env-mode development",
    "dev:prod": "rsbuild dev --env-mode production",
    "build": "rsbuild build",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write",
    "format": "prettier --write .",
    "preview": "rsbuild preview",
    "reinstall": "rimraf pnpm-lock.yaml && rimraf node_modules && pnpm install"
  },
  "dependencies": {
    "@alova/adapter-axios": "^2.0.20",
    "@ant-design/icons": "~6.3.4",
    "ahooks": "^3.10.0",
    "alova": "^3.5.5",
    "antd": "^6.6.3",
    "dayjs": "^1.11.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@commitlint/config-conventional": "^21.2.2",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-react": "^2.1.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-svgr": "^2.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@unocss/postcss": "^66.10.0",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "unocss": "^66.10.0",
    "unplugin-auto-import": "^21.1.0"
  }
}
